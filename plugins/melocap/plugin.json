{
  "id": "melocap",
  "experimental": true,
  "name": "MeloCap",
  "type": "fx",
  "targets": [
    "nts-3_kaoss"
  ],
  "description": "DJM Melodic capture. Touch plays the last captured stub at a scale-quantized pitch (X) and grain length (Y). A long hold recaptures AUDIO IN.",
  "params": [
    {
      "name": "NOTE",
      "role": "X",
      "detail": "Scale-quantized pitch"
    },
    {
      "name": "SIZE",
      "role": "Y",
      "detail": "Grain / loop length"
    },
    {
      "name": "MIX",
      "role": "Depth",
      "detail": "Dry/wet"
    },
    {
      "name": "SCALE",
      "role": "Edit",
      "detail": "MIN, MAJ, or PENT"
    },
    {
      "name": "ROOT",
      "role": "Edit",
      "detail": "Key center around C"
    }
  ]
}
