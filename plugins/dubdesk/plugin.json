{
  "id": "dubdesk",
  "experimental": true,
  "name": "DubDesk",
  "type": "fx",
  "targets": [
    "nts-3_kaoss"
  ],
  "description": "Dub delay desk: feedback path through a moving band-pass, with L/R offset. X throws feedback toward self-oscillation. Y is the return cutoff. Touch is a one-shot full-wet echo throw.",
  "params": [
    {
      "name": "SEND",
      "role": "X",
      "detail": "Feedback throw, into self-oscillation"
    },
    {
      "name": "TONE",
      "role": "Y",
      "detail": "Band-pass cutoff in the return"
    },
    {
      "name": "MIX",
      "role": "Depth",
      "detail": "Send / wet level"
    },
    {
      "name": "TIME",
      "role": "Edit",
      "detail": "Delay time, tempo-synced"
    },
    {
      "name": "SPRD",
      "role": "Edit",
      "detail": "L/R delay offset"
    }
  ]
}
