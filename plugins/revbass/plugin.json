{
  "id": "revbass",
  "experimental": true,
  "name": "RevBass",
  "type": "synth",
  "targets": [
    "nts-3_kaoss"
  ],
  "description": "Hardstyle reverse bass. Touch gates a swell that locks to off-beats. X = pitch, Y = attack length and drive.",
  "params": [
    {
      "name": "PITCH",
      "role": "X",
      "detail": "Bass pitch"
    },
    {
      "name": "ATK",
      "role": "Y",
      "detail": "Reverse attack length and drive"
    },
    {
      "name": "MIX",
      "role": "Depth",
      "detail": "Level"
    },
    {
      "name": "SYNC",
      "role": "Edit",
      "detail": "FREE or OFFB (off-beat absorb)"
    }
  ]
}
