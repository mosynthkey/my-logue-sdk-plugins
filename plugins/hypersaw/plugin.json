{
  "id": "hypersaw",
  "name": "HyperSaw",
  "type": "osc",
  "targets": ["nts-1_mkii", "microkorg2"],
  "description": "Virus TI-inspired 9-voice detuned saw stack with Density, Spread, HyperSub, and stereo width.",
  "params": [
    { "name": "DENS", "role": "A", "detail": "Active saw count (1-9) with crossfade" },
    { "name": "SPRD", "role": "B", "detail": "Detune spread (Virus-style curve)" },
    { "name": "SUB", "role": "Edit", "detail": "HyperSub square mix (1 octave down)" },
    { "name": "WIDTH", "role": "Edit", "detail": "Stereo spread of detuned voices" }
  ]
}
