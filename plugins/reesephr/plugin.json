{
  "id": "reesephr",
  "experimental": true,
  "name": "ReesePhr",
  "type": "synth",
  "targets": [
    "nts-3_kaoss"
  ],
  "description": "Detuned Reese drone with a sparse phrase generator. Touch gates a beating supersaw; Y sets detune / beat speed. Every 1\u20132 bars the root may walk a minor third inside the scale so the pressure changes without a melody.",
  "params": [
    {
      "name": "PITCH",
      "role": "X",
      "detail": "Root pitch of the drone"
    },
    {
      "name": "DETUN",
      "role": "Y",
      "detail": "Detune / beating speed"
    },
    {
      "name": "MIX",
      "role": "Depth",
      "detail": "Dry/wet"
    },
    {
      "name": "ROOT",
      "role": "Edit",
      "detail": "Phrase key"
    },
    {
      "name": "RATE",
      "role": "Edit",
      "detail": "How often the drone walks"
    },
    {
      "name": "SUB",
      "role": "Edit",
      "detail": "Sub square one octave down"
    }
  ]
}
